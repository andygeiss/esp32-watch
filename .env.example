# Copy to .env and fill in. `make run` sources .env when it is there; .env is
# gitignored because one of these lines is a secret, and this file is the
# shape of it without one.
#
# Every value is quoted, and that is not decoration: the shell sources the
# file, so an unquoted value holding a space or a '|' is not an assignment at
# all. WATCH_WAKE_PHRASE=hey ada|hey adah assigns "hey" in front of the
# command `ada`, pipes it into `hey adah`, and leaves the variable empty. The
# `command not found: ada` that says so scrolls past in the middle of a build.
#
# Every setting here has a default in voice/turn.h and an empty value means
# that default, so a line is only needed to say something else. The watch logs
# what it actually took at start-up. The device has the same list under
# `idf.py -C firmware menuconfig`, as CONFIG_WATCH_*.

# Where the server that hears, thinks and speaks is. https goes through TLS;
# http skips it, which is what an oMLX on this machine wants. Empty is
# http://127.0.0.1:8000.
WATCH_VOICE_URL="https://omlx.ai-at-home.de"

# Sent as "Authorization: Bearer <key>". A server published on the internet
# checks one — the proxy in front of the address above holds no secret, so the
# service behind it is what does the checking. Empty sends no Authorization
# header at all, which is not the same as sending an empty one.
WATCH_VOICE_KEY=""

# What the assistant thinks with. Empty is Qwen3.8-27B-oQ4e-mtp, the model the
# watch was built against. Write "echo" and there is no chat request at all:
# the answer becomes the question said back, word for word, which needs no
# third service and is the shortest path through the whole pipeline.
WATCH_BRAIN_MODEL=""

# What the assistant calls itself — the answer to "who are you?", carried to
# the chat model in the system prompt. Empty is "Kai".
#
# Two settings on purpose, this and the phrase below. The wake list is what
# the transcriber writes down for a name it has never been shown, and its
# built-in spellings include "hey ky" and "hey chai" — a name taken from it
# would have the watch introducing itself as Chai. Set both, or the watch
# answers to Ada and says it is Kai. The start-up log names both.
#
#   WATCH_NAME="Ada"
#   WATCH_WAKE_PHRASE="hey ada|hey adah|hi ada"
WATCH_NAME=""

# What the watch answers to, spellings separated by '|'. Empty is the six in
# voice/turn.c, which is the only place they are written down. Match the
# greeting and not the name on its own, or every word that merely starts the
# same way wakes the watch — Kaiser, Kaimauer and half the German news.
# Case and punctuation do not matter.
#
#   WATCH_WAKE_PHRASE="hey ada|hey adah|hi ada"
WATCH_WAKE_PHRASE=""

# The rest of the list. Empty is the default in voice/turn.h for each:
# parakeet-tdt-0.6b-v3, chatterbox-multilingual-v3, and "de" for the language
# the synthesiser is told to speak.
WATCH_STT_MODEL=""
WATCH_TTS_MODEL=""
WATCH_LANGUAGE=""
