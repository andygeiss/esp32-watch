menu "ESP32 Watch"

    # The network's name and password, the server, its key, the models, the
    # name and the wake phrase are not here. They are the WATCH_* lines in
    # .env, which `make firmware` compiles in — the same list the simulator
    # reads, two of them secrets, and .env is where this repository keeps
    # those. See firmware/main/CMakeLists.txt.

    config WATCH_SNTP_SERVER
        string "SNTP server"
        default "pool.ntp.org"

    config WATCH_TIMEZONE
        string "POSIX TZ string"
        default "CET-1CEST,M3.5.0,M10.5.0/3"
        help
            SNTP hands out UTC and the device has no locale to convert it
            with, so the zone is compiled in. The default is central Europe
            with EU daylight saving.

endmenu
